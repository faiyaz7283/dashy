# Dashy Production Environment Variables
# Copy this file to env/.env.prod and fill in actual values

# Environment
ENVIRONMENT=production

# Google Calendar
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_JSON=/app/credentials/service-account.json

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key
OPENWEATHERMAP_LAT=40.715401
OPENWEATHERMAP_LON=-73.512924

# Family Members (JSON array)
FAMILY_MEMBERS=[{"name":"Faiyaz","key":"faiyaz","calendar_id":"faiyaz@gmail.com","color":"#4A90E2"},{"name":"Trisha","key":"trisha","calendar_id":"trisha@gmail.com","color":"#E24A8D"}]
