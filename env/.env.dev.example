# Dashy Development Environment Variables
# Copy this file to .env.dev and fill in actual values

# Environment
ENVIRONMENT=development

# Domains (for Traefik routing)
FRONTEND_DOMAIN=dashy.local
BACKEND_DOMAIN=api.dashy.local

# Google Calendar
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key
OPENWEATHERMAP_LAT=40.715401
OPENWEATHERMAP_LON=-73.512924
WEATHER_USE_MOCK=true
CALENDAR_USE_MOCK=true
CHORES_USE_MOCK=false

# CORS (comma-separated origins)
CORS_ORIGINS=https://dashy.local,https://dashy-v2.local,http://localhost:3000,http://dashy.local,http://dashy-v2.local

# Cache
REDIS_URL=redis://redis:6379
WEATHER_CACHE_TTL=600
CALENDAR_CACHE_TTL=120

# Timezone (IANA identifier)
TIMEZONE=America/New_York

# PostgreSQL
POSTGRES_USER=dashy
POSTGRES_PASSWORD=dashy
POSTGRES_DB=dashy

# Family Members (JSON array)
# Each member's email (also used as Google Calendar ID) — events are fetched from each and color-coded
FAMILY_MEMBERS=[{"name":"Faiyaz","key":"faiyaz","email":"faiyaz7283@gmail.com","color":"#4A90E2"},{"name":"Trisha","key":"trisha","email":"humairaabbasi26@gmail.com","color":"#E24A8D"},{"name":"Arya","key":"arya","email":"aryahaider1210@gmail.com","color":"#4ADE80"},{"name":"Raya","key":"raya","email":"rayahaider23@gmail.com","color":"#FBBF24"}]
