# Dashy Development Environment Variables
# Copy this file to .env.dev and fill in actual values

# Environment
ENVIRONMENT=development

# Domains (for Traefik routing)
FRONTEND_DOMAIN=dashy.local
BACKEND_DOMAIN=api.dashy.local

# Google Calendar
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key
OPENWEATHERMAP_LAT=40.7259
OPENWEATHERMAP_LON=-73.5143

# Family Members (JSON array)
FAMILY_MEMBERS=[{"name":"Faiyaz","key":"faiyaz","calendar_id":"faiyaz@gmail.com","color":"#4A90E2"},{"name":"Trisha","key":"trisha","calendar_id":"trisha@gmail.com","color":"#E24A8D"}]
