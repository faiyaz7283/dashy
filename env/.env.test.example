# Test Environment Configuration
# This file contains test-specific environment variables
# Copy to .env.test and customize if needed

# Environment
ENVIRONMENT=testing

# Google Calendar (test values)
GOOGLE_SERVICE_ACCOUNT_JSON=/app/credentials/test.json

# OpenWeatherMap (test values)
OPENWEATHERMAP_API_KEY=test-api-key
OPENWEATHERMAP_LAT=40.715401
OPENWEATHERMAP_LON=-73.512924
WEATHER_USE_MOCK=true
CALENDAR_USE_MOCK=true
CHORES_USE_MOCK=false

# CORS (test values)
CORS_ORIGINS=http://testserver

# Cache
REDIS_URL=redis://redis:6379
WEATHER_CACHE_TTL=600
CALENDAR_CACHE_TTL=120

# Timezone (tests use UTC for determinism)
TIMEZONE=UTC

# PostgreSQL (test database)
POSTGRES_USER=dashy_test
POSTGRES_PASSWORD=test_password
POSTGRES_DB=dashy_test

