# Production Docker Compose template
# Copy to docker-compose.prod.yml and fill in actual values

services:
  frontend:
    build:
      context: ../frontend
      dockerfile: Dockerfile
    ports:
      - "80:80"
    environment:
      - VITE_API_URL=https://your-domain.com/api

  backend:
    build:
      context: ../backend
      dockerfile: Dockerfile
    ports:
      - "8000:8000"
    env_file:
      - ../env/.env.prod
    environment:
      - PYTHONUNBUFFERED=1
